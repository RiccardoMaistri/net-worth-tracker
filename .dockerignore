# Dependencies — reinstalled inside the container
node_modules

# Build output — rebuilt inside the container
.next
.next-*
build
out

# Git history — not needed at runtime
.git
.gitignore

# Local environment files — secrets must be injected at runtime, never baked in
.env
.env.local
.env*.local

# Editor artifacts
.DS_Store
*.swp
*.swo
.vscode
.idea

# Test and e2e artifacts
coverage
__tests__
e2e
test-results
playwright-report

# Documentation
*.md
!README.md

# Firebase emulator data, keys and logs
.firebase
.emulator-data
firebase-export-*
firebase-admin-key.json
*.log
*.log*

# Local tool directories
.agents
.antigravitycli
skills-lock.json
.vercel

# TypeScript incremental build info
*.tsbuildinfo
next-env.d.ts

